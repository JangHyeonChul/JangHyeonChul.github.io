---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../site.config';
import { formatDate } from '../lib/content';

// 여러 장이 있으면 가장 최근에 고친 것 한 장만 싣는다.
const visible = (e: { data: { draft: boolean } }) => import.meta.env.DEV || !e.data.draft;
const docs = (await getCollection('resume'))
  .filter(visible)
  .sort((a, b) => b.data.updated.valueOf() - a.data.updated.valueOf());

const doc = docs[0];
const Content = doc ? (await render(doc)).Content : null;
---

<BaseLayout
  title={doc?.data.title ?? '경력기술서'}
  description={doc?.data.summary ?? `${site.name}의 경력기술서.`}
  surface="blog"
>
  <article class="doc">
    <header class="doc__head">
      <div class="wrap wrap--prose">
        <nav class="crumb no-print" aria-label="경로">
          <a href="/">프로젝트</a>
          <span aria-hidden="true">/</span>
          <a href="/about/">About</a>
          <span aria-hidden="true">/</span>
          <span aria-current="page">경력기술서</span>
        </nav>

        <div class="doc__bar">
          <div>
            <h1 class="doc__title">{doc?.data.title ?? '경력기술서'}</h1>
            {doc?.data.summary && <p class="doc__summary">{doc.data.summary}</p>}
          </div>

          {doc && (
            <button class="btn btn--ghost no-print" type="button" data-print>
              <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
                <path
                  d="M4.5 6V2.5h7V6M4.5 12H3.5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h9a1 1 0 0 1 1 1v4a1 1 0 0 1-1 1h-1M4.5 10h7v3.5h-7z"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.3"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
              PDF 로 저장
            </button>
          )}
        </div>

        {doc && (
          <p class="doc__meta caption">
            <span class="print-only">{site.name}</span>
            최종 수정 {formatDate(doc.data.updated)}
          </p>
        )}
      </div>
    </header>

    {doc ? (
      <div class="wrap wrap--prose">
        <div class="prose"><Content /></div>
      </div>
    ) : (
      <div class="wrap wrap--prose">
        <div class="empty">
          <p class="empty__line">아직 공개된 경력기술서가 없습니다.</p>
          <p class="caption">
            <code>src/content/resume/</code> 의 <code>.md</code> 에서 <code>draft: true</code> 를
            지우면 이 자리에 실립니다.
          </p>
        </div>
      </div>
    )}

    <div class="wrap wrap--prose doc__back no-print">
      <a class="btn btn--ghost" href="/about/">← About 으로</a>
    </div>
  </article>
</BaseLayout>

<script>
  document.querySelector('[data-print]')?.addEventListener('click', () => window.print());
</script>

<style>
  .wrap--prose { max-width: var(--maxw-prose); }

  .doc__head {
    padding-block: var(--s5) var(--s8);
    margin-bottom: var(--s8);
    border-bottom: 1px solid var(--hairline);
  }
  .crumb {
    display: flex;
    align-items: center;
    gap: var(--s2);
    font-size: 13px;
    color: var(--faint);
    margin-bottom: var(--s6);
  }
  .crumb a { color: var(--muted); }
  .crumb a:hover { color: var(--brand-bright); }
  .crumb [aria-current] { color: var(--ink-soft); }

  .doc__bar {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--s4);
  }
  .doc__title {
    animation: titleIn var(--t-slow) var(--e-enter) both;
    font-size: clamp(26px, 4.5vw, 36px);
    font-weight: 700;
    line-height: 1.3;
    letter-spacing: -0.6px;
    color: var(--ink);
  }
  .doc__summary {
    margin-top: var(--s2);
    font-size: 16px;
    color: var(--muted);
    word-break: keep-all;
  }
  .doc__meta { margin-top: var(--s4); display: flex; gap: var(--s2); }

  /* 인쇄물에만 나오는 이름 — 화면에서는 헤더가 그 역할을 한다 */
  .print-only { display: none; }

  .doc__back { margin-top: var(--s12); }

  .empty {
    padding: var(--s12) var(--s5);
    border-radius: var(--r-card);
    box-shadow: var(--ring);
    text-align: center;
  }
  .empty__line { color: var(--ink); margin-bottom: var(--s2); }
  .empty code {
    font-family: var(--font-mono);
    font-size: 12px;
    padding: 0.15em 0.4em;
    border-radius: var(--r-chip);
    background: var(--surface-2);
    color: var(--brand-bright);
  }

  @media print {
    .doc__head { padding-top: 0; margin-bottom: var(--s6); }
    .doc__title { animation: none; }
    .print-only { display: inline; }
    .print-only::after { content: ' ·'; }
  }
</style>
