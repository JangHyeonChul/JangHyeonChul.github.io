---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../site.config';
import { about } from '../about.config';
import { formatDate } from '../lib/content';

// 여러 장이 있으면 가장 최근에 고친 것 한 장만 싣는다.
const visible = (e: { data: { draft: boolean } }) => import.meta.env.DEV || !e.data.draft;
const docs = (await getCollection('resume'))
  .filter(visible)
  .sort((a, b) => b.data.updated.valueOf() - a.data.updated.valueOf());

const doc = docs[0];
// 본문(마크다운)은 내용이 있을 때만 싣는다. 지금은 모두 위쪽 데이터로 그린다.
const hasBody = !!doc?.body?.trim();
const Content = doc && hasBody ? (await render(doc)).Content : null;
const intro = doc?.data.intro ?? [];
const skills = doc?.data.skills ?? [];
const career = doc?.data.career ?? [];

// 상단 연락처: 사이트 바로가기 중 외부 링크만. 화면에는 주소를 그대로 보인다(인쇄물에서도 읽히도록).
const contacts = site.contacts.filter((c) => !c.href.startsWith('/'));
const role = about.career[0]?.role ?? site.role;
const { education, certifications } = about;
---

<BaseLayout
  title={doc?.data.title ?? '경력기술서'}
  description={doc?.data.summary ?? `${site.name}의 경력기술서.`}
  surface="blog"
>
  {/* 메인 히어로와 같은 이름의 띠. 페이지를 넘길 때 히어로가 이 띠로 줄어든다 */}
  <section class="band">
    <div class="wrap">
      <div class="band__bar no-print">
        <nav class="crumb" aria-label="경로">
          <a href="/">프로젝트</a>
          <span aria-hidden="true">/</span>
          <a href="/about/">About</a>
          <span aria-hidden="true">/</span>
          <span aria-current="page">경력기술서</span>
        </nav>

        {doc && (
          <div class="band__tools">
            <span class="caption">최종 수정 {formatDate(doc.data.updated)}</span>
            <button class="btn btn--ghost" type="button" data-print>
              <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
                <path
                  d="M4.5 6V2.5h7V6M4.5 12H3.5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h9a1 1 0 0 1 1 1v4a1 1 0 0 1-1 1h-1M4.5 10h7v3.5h-7z"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.3"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
              PDF 로 저장
            </button>
          </div>
        )}
      </div>

      <header class="band__head">
        <div>
          <h1 class="band__name">{site.name}</h1>
          <p class="band__role">{role}</p>
        </div>

        {contacts.length > 0 && (
          <dl class="contacts">
            {contacts.map((c) => (
              <div class="contacts__row">
                <dt>{c.label}</dt>
                <dd><a href={c.href}>{c.value}</a></dd>
              </div>
            ))}
          </dl>
        )}
      </header>
    </div>
  </section>

  <article class="wrap cv">
    {!doc && (
      <div class="empty">
        <p class="empty__line">아직 공개된 경력기술서가 없습니다.</p>
        <p class="caption">
          <code>src/content/resume/</code> 의 <code>.md</code> 에서 <code>draft: true</code> 를
          지우면 이 자리에 실립니다.
        </p>
      </div>
    )}

    {intro.length > 0 && (
      <section>
        <h2 class="sec">요약</h2>
        <ul class="points points--lead">
          {intro.map((line) => <li>{line}</li>)}
        </ul>
      </section>
    )}

    {skills.length > 0 && (
      <section>
        <h2 class="sec">핵심 역량</h2>
        <ul class="skills">
          {skills.map((s) => (
            <li class="skill">
              <p class="skill__label">{s.label}</p>
              <ul class="chips">
                {s.items.map((it) => <li class="chip">{it}</li>)}
              </ul>
            </li>
          ))}
        </ul>
      </section>
    )}

    {career.length > 0 && (
      <section>
        <h2 class="sec">경력</h2>
        {career.map((c) => (
          <div class="job">
            <div class="job__head">
              <h3 class="job__title">
                {c.company}
                {c.company && c.role && <span class="job__role"> · </span>}
                {c.role && <span class={c.company ? 'job__role' : ''}>{c.role}</span>}
              </h3>
              {c.period && <p class="period">{c.period}</p>}
            </div>
            {c.note && <p class="job__note">{c.note}</p>}

            {c.projects.length > 0 && (
              <ul class="projects">
                {c.projects.map((p) => (
                  <li class="proj">
                    <div class="proj__head">
                      <h4 class="proj__name">{p.name}</h4>
                      {p.period && <p class="period">{p.period}</p>}
                    </div>
                    {p.overview && <p class="proj__overview">{p.overview}</p>}

                    {(p.role || p.team || p.stack.length > 0) && (
                      <dl class="meta">
                        {p.role && (<><dt>역할</dt><dd>{p.role}</dd></>)}
                        {p.team && (<><dt>인원</dt><dd>{p.team}</dd></>)}
                        {p.stack.length > 0 && (
                          <>
                            <dt>기술</dt>
                            <dd>
                              <ul class="chips" aria-label="기술 스택">
                                {p.stack.map((t) => <li class="chip">{t}</li>)}
                              </ul>
                            </dd>
                          </>
                        )}
                      </dl>
                    )}

                    {p.tasks.length > 0 && (
                      <>
                        <h5 class="proj__label">주요 업무</h5>
                        <ul class="points">
                          {p.tasks.map((t) => <li>{t}</li>)}
                        </ul>
                      </>
                    )}
                    {p.outcomes.length > 0 && (
                      <div class="outcomes">
                        <h5 class="proj__label">성과</h5>
                        <ul class="points">
                          {p.outcomes.map((o) => <li>{o}</li>)}
                        </ul>
                      </div>
                    )}
                    {p.issues.length > 0 && (
                      <>
                        <h5 class="proj__label">문제 해결</h5>
                        <ul class="points">
                          {p.issues.map((t) => <li>{t}</li>)}
                        </ul>
                      </>
                    )}
                  </li>
                ))}
              </ul>
            )}
          </div>
        ))}
      </section>
    )}

    {Content && <div class="cv__body"><Content /></div>}

    {(education.length > 0 || certifications.length > 0) && (
      <div class="foot">
        {education.length > 0 && (
          <section>
            <h2 class="sec">학력</h2>
            <ul class="plain">
              {education.map((e) => (
                <li>{[e.school, e.degree, e.period, e.note].filter(Boolean).join(' | ')}</li>
              ))}
            </ul>
          </section>
        )}
        {certifications.length > 0 && (
          <section>
            <h2 class="sec">자격</h2>
            <ul class="plain">
              {certifications.map((c) => (
                <li>{[c.name, c.issuer, c.date].filter(Boolean).join(' | ')}</li>
              ))}
            </ul>
          </section>
        )}
      </div>
    )}
  </article>
</BaseLayout>

<script>
  document.querySelector('[data-print]')?.addEventListener('click', () => window.print());
</script>

<style>
  /* ── 상단 띠: 메인 히어로의 민트를 캔버스 쪽으로 한 톤 눌러 구분한다 ── */
  .band {
    view-transition-name: band;
    background: color-mix(in srgb, var(--brand) 6%, var(--canvas));
    border-bottom: 1px solid var(--hairline);
    padding-block: var(--s5) var(--s6);
    margin-bottom: var(--s8);
  }
  .band__bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--s3);
    margin-bottom: var(--s6);
  }
  .crumb {
    display: flex;
    align-items: center;
    gap: var(--s2);
    font-size: 13px;
    color: var(--faint);
  }
  .crumb a { color: var(--muted); }
  .crumb a:hover { color: var(--brand-bright); }
  .crumb [aria-current] { color: var(--ink-soft); }
  .band__tools { display: flex; align-items: center; gap: var(--s4); }
  .band__tools .btn { background: var(--surface); }

  .band__head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--s5);
  }
  /* 메인 이름보다 한 단계 작게 */
  .band__name {
    animation: titleIn var(--t-slow) var(--e-enter) both;
    font-size: clamp(28px, 4vw, 36px);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.7px;
    color: var(--ink);
  }
  .band__role {
    margin-top: var(--s2);
    font-size: 16px;
    font-weight: 600;
    color: var(--brand-bright);
  }
  .contacts {
    display: grid;
    grid-template-columns: auto auto;
    column-gap: var(--s8);
    row-gap: var(--s1);
    font-size: 14px;
  }
  .contacts__row { display: contents; }
  .contacts dt {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.8px;
    text-transform: uppercase;
    color: var(--faint);
    align-self: center;
  }
  .contacts dd { text-align: right; color: var(--body); }
  .contacts a:hover { color: var(--brand-bright); }

  /* ── 본문 공통 ─────────────────────────────── */
  .cv { padding-bottom: var(--s12); }

  .sec,
  .cv__body :global(h2) {
    display: flex;
    align-items: center;
    gap: var(--s6);
    margin: var(--s12) 0 var(--s5);
    font-size: 17px;
    font-weight: 700;
    color: var(--ink-soft);
  }
  .cv > section:first-child .sec { margin-top: var(--s4); }
  .sec::after,
  .cv__body :global(h2)::after {
    content: '';
    flex: 1;
    height: 1px;
    background: var(--hairline);
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s1) 6px;
    list-style: none;
    padding: 0;
  }
  .period {
    flex-shrink: 0;
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.4px;
    color: var(--faint);
  }

  /* ── 핵심 역량: 카드 격자 ───────────────────── */
  .skills {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(196px, 1fr));
    gap: var(--s4);
    list-style: none;
    padding: 0;
  }
  .skill {
    padding: var(--s5);
    border-radius: var(--r-card);
    background: var(--surface);
    box-shadow: var(--ring);
  }
  .skill__label {
    margin-bottom: var(--s3);
    font-size: 13px;
    font-weight: 700;
    color: var(--ink-soft);
  }

  /* ── 경력: 회사 머리 + 가로로 긴 프로젝트 카드 ─── */
  .job + .job { margin-top: var(--s12); }
  .job__head,
  .proj__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--s4);
  }
  .job__title { font-size: 20px; font-weight: 700; color: var(--ink); line-height: 1.4; }
  .job__role { font-weight: 600; color: var(--muted); }
  .job__note { margin-top: var(--s1); font-size: 15px; color: var(--body); word-break: keep-all; }

  .projects {
    display: grid;
    gap: var(--s3);
    margin-top: var(--s5);
    list-style: none;
    padding: 0;
  }
  .proj {
    padding: var(--s5) var(--s6);
    border-radius: var(--r-card);
    background: var(--surface);
    box-shadow: var(--ring);
    transition: box-shadow var(--t-std) var(--e-std);
  }
  .proj:hover { box-shadow: var(--ring), var(--shadow-card); }

  .proj__overview {
    margin-top: var(--s2);
    font-size: 15px;
    line-height: 1.7;
    color: var(--ink-soft);
    word-break: keep-all;
  }

  /* 역할 · 인원 · 기술 — 왼쪽 라벨, 오른쪽 값 */
  .meta {
    display: grid;
    grid-template-columns: auto 1fr;
    column-gap: var(--s4);
    row-gap: var(--s2);
    align-items: baseline;
    margin-top: var(--s4);
    font-size: 14px;
  }
  .meta dt {
    font-size: 12px;
    font-weight: 700;
    color: var(--faint);
  }
  .meta dd { margin: 0; color: var(--body); word-break: keep-all; }
  .meta .chips { margin-top: 0; }

  .proj__label {
    margin-top: var(--s5);
    font-size: 13px;
    font-weight: 700;
    color: var(--ink-soft);
  }
  .proj__label + .points { margin-top: var(--s2); }

  /* 성과 — 브랜드 색 세로줄로 한 번 더 눈에 걸리게 */
  .outcomes {
    margin-top: var(--s5);
    padding: var(--s1) 0 var(--s1) var(--s4);
    border-left: 2px solid var(--brand-bright);
  }
  .outcomes .proj__label { margin-top: 0; color: var(--brand-bright); }
  .outcomes li { color: var(--ink-soft); }

  /* 요약 — 본문보다 한 단계 큰 글자 */
  .points--lead li { font-size: 16px; color: var(--ink-soft); }
  .points--lead li + li { margin-top: var(--s2); }

  .proj__name { font-size: 17px; font-weight: 700; color: var(--ink); line-height: 1.4; }

  /* 대시 불릿, 두 번째 줄부터는 글머리 뒤로 들여쓴다 */
  .points,
  .cv__body :global(ul) {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .points { margin-top: var(--s4); }
  .points li,
  .cv__body :global(li) {
    position: relative;
    padding-left: 1.1em;
    font-size: 15px;
    line-height: 1.75;
    color: var(--body);
    word-break: keep-all;
  }
  .points li + li { margin-top: var(--s1); }
  .points li::before,
  .cv__body :global(li)::before {
    content: '–';
    position: absolute;
    left: 0;
    color: var(--faint);
  }

  /* ── 마크다운 본문(개인 프로젝트 등) ───────────── */
  .cv__body {
    font-size: 15px;
    line-height: 1.75;
    color: var(--body);
    word-break: keep-all;
  }
  .cv__body :global(p) { margin: 0 0 var(--s3); }
  .cv__body :global(a) { color: var(--brand-bright); }

  /* ── 하단: 학력 | 자격 두 칸 ───────────────── */
  .foot {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0 var(--s12);
  }
  .plain { list-style: none; padding: 0; font-size: 15px; line-height: 1.75; color: var(--body); }
  .plain li + li { margin-top: var(--s2); }

  .empty {
    padding: var(--s12) var(--s5);
    border-radius: var(--r-card);
    box-shadow: var(--ring);
    text-align: center;
  }
  .empty__line { color: var(--ink); margin-bottom: var(--s2); }
  .empty code {
    font-family: var(--font-mono);
    font-size: 12px;
    padding: 0.15em 0.4em;
    border-radius: var(--r-chip);
    background: var(--surface-2);
    color: var(--brand-bright);
  }

  @media (max-width: 640px) {
    .contacts { column-gap: var(--s5); }
    .contacts dd { text-align: left; }
    .foot { grid-template-columns: 1fr; }
    .job__head,
    .proj__head { flex-wrap: wrap; row-gap: 0; }
    .proj { padding: var(--s4) var(--s5); }
  }

  @media print {
    .band { background: none; border-bottom: 2px solid var(--ink-soft); padding-top: 0; }
    .band__name { animation: none; }
    .skill,
    .proj { box-shadow: var(--ring); break-inside: avoid; }
  }
</style>
