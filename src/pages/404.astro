---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="페이지를 찾을 수 없습니다">
  <section class="wrap nf">
    <p class="nf__code">404</p>
    <h1 class="nf__title">주소에 해당하는 페이지가 없습니다.</h1>
    <p class="nf__desc">
      링크가 오래되었거나, 글이 다른 주소로 옮겨졌을 수 있습니다.
    </p>
    <a class="btn btn--primary" href="/">프로젝트 목록으로</a>
  </section>
</BaseLayout>

<style>
  /* HDS Error 상태: 맨 "오류가 발생했습니다" 대신 무엇이 왜인지 설명하고 길을 준다 */
  .nf {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--s3);
    padding-block: var(--s12);
    max-width: 52ch;
  }
  .nf__code {
    font-size: 13px;
    font-weight: 600;
    color: var(--brand-bright);
    font-variant-numeric: tabular-nums;
  }
  .nf__title {
    font-size: clamp(24px, 4vw, 32px);
    font-weight: 700;
    letter-spacing: -0.6px;
    color: var(--ink);
    word-break: keep-all;
  }
  .nf__desc { color: var(--muted); word-break: keep-all; margin-bottom: var(--s3); }
</style>
