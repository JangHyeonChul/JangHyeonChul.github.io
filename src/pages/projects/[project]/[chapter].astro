---
import { render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import {
  getProjects, getChapters, splitChapterId, readingTime, formatDate,
} from '../../../lib/content';

export async function getStaticPaths() {
  const projects = await getProjects();
  const paths = [];

  for (const project of projects) {
    const chapters = await getChapters(project.id);

    chapters.forEach((entry, i) => {
      const { chapter } = splitChapterId(entry.id);
      paths.push({
        params: { project: project.id, chapter },
        props: {
          project,
          entry,
          n: i + 1,
          total: chapters.length,
          // 이전/다음 글 — 같은 프로젝트 안에서 order 순
          prev: i > 0 ? chapters[i - 1] : null,
          next: i < chapters.length - 1 ? chapters[i + 1] : null,
        },
      });
    });
  }
  return paths;
}

const { project, entry, n, total, prev, next } = Astro.props;
const { Content } = await render(entry);

const mins = readingTime(entry.body);
const date = formatDate(entry.data.date);
const linkTo = (c: typeof prev) =>
  c ? `/projects/${project.id}/${splitChapterId(c.id).chapter}/` : '#';
---

<BaseLayout title={entry.data.title} description={entry.data.description ?? project.data.summary} surface="blog">
  <article class="post">
    <header class="post__head">
      <div class="wrap wrap--prose">
        <nav class="crumb" aria-label="경로">
          <a href="/">프로젝트</a>
          <span aria-hidden="true">/</span>
          <a href={`/projects/${project.id}/`}>{project.data.title}</a>
        </nav>

        {entry.data.category && <span class="chip chip--brand post__cat">{entry.data.category}</span>}

        <h1 class="post__title">{entry.data.title}</h1>

        {entry.data.description && <p class="post__desc">{entry.data.description}</p>}

        <div class="post__meta">
          <span class="caption">{n} / {total}</span>
          {date && <><span class="caption" aria-hidden="true">·</span><span class="caption">{date}</span></>}
          <span class="caption" aria-hidden="true">·</span>
          <span class="caption">약 {mins}분</span>
        </div>
      </div>
    </header>

    <div class="wrap wrap--prose">
      <div class="prose post__body">
        <Content />
      </div>
    </div>

    <nav class="wrap wrap--prose post__nav" aria-label="챕터 이동">
      {prev ? (
        <a class="pn pn--prev" href={linkTo(prev)}>
          <span class="caption">이전 챕터</span>
          <span class="pn__t">{prev.data.title}</span>
        </a>
      ) : <span></span>}

      {next ? (
        <a class="pn pn--next" href={linkTo(next)}>
          <span class="caption">다음 챕터</span>
          <span class="pn__t">{next.data.title}</span>
        </a>
      ) : <span></span>}
    </nav>

    <div class="wrap wrap--prose post__back">
      <a class="btn btn--ghost" href={`/projects/${project.id}/`}>
        ← {project.data.title} 챕터 목록
      </a>
    </div>
  </article>

  {/* 떠 있는 이전/다음 — 헤더를 지나 내려가면 나타나고, 맨 아래 이전/다음 카드가 보이면 숨는다 */}
  <nav class="dock" aria-label="챕터 이동 (고정)" data-dock>
    {prev ? (
      <a class="dock__btn" href={linkTo(prev)} title={`이전 챕터: ${prev.data.title}`}>
        <span class="dock__arrow" aria-hidden="true">‹</span>
        <span class="dock__t">{prev.data.title}</span>
      </a>
    ) : (
      <span class="dock__btn is-off" aria-hidden="true"><span class="dock__arrow">‹</span><span class="dock__t">처음 챕터</span></span>
    )}

    <a class="dock__mid" href={`/projects/${project.id}/`} title={`${project.data.title} 챕터 목록`}>
      {n} / {total}
    </a>

    {next ? (
      <a class="dock__btn dock__btn--next" href={linkTo(next)} title={`다음 챕터: ${next.data.title}`}>
        <span class="dock__t">{next.data.title}</span>
        <span class="dock__arrow" aria-hidden="true">›</span>
      </a>
    ) : (
      <span class="dock__btn dock__btn--next is-off" aria-hidden="true"><span class="dock__t">마지막 챕터</span><span class="dock__arrow">›</span></span>
    )}
  </nav>
</BaseLayout>

<script>
  const dock = document.querySelector<HTMLElement>('[data-dock]');
  const head = document.querySelector('.post__head');
  const foot = document.querySelector('.post__nav');

  if (dock && head && foot) {
    // 스크롤할 때마다 위치를 직접 잰다. 이벤트를 모아 받는 방식은 빠르게 스크롤하면
    // 지난 상태로 판단해 바가 안 뜨는 일이 있어서, 매 프레임 한 번씩 다시 계산한다.
    let queued = false;
    const update = () => {
      queued = false;
      const pastHead = head.getBoundingClientRect().bottom <= 0;            // 헤더가 화면 위로 다 올라감
      const footInView = foot.getBoundingClientRect().top < innerHeight;   // 맨 아래 이전/다음이 보이기 시작함
      dock.classList.toggle('is-on', pastHead && !footInView);
    };
    const request = () => {
      if (!queued) {
        queued = true;
        requestAnimationFrame(update);
      }
    };

    addEventListener('scroll', request, { passive: true });
    addEventListener('resize', request);
    // 이미지가 늦게 들어와 높이가 바뀌거나, 뒤로 가기로 중간 위치에서 열릴 때도 다시 잰다
    addEventListener('load', request);
    addEventListener('pageshow', request);
    update();
  }
</script>

<style>
  /* ── 블로그 표면 ──────────────────────────────────────
     HDS 2-surface 규칙: 여기서는 Spoqa Han Sans + 에디토리얼
     스케일(32px/700/-1px/1.44) + 20px 라디우스를 쓴다.      */
  /* 챕터 글도 사이트 헤더와 같은 폭(--maxw)을 쓴다 */
  .wrap--prose { max-width: var(--maxw); }

  .post__head {
    background: var(--brand-tint);
    border-bottom: 1px solid var(--hairline);
    padding-block: var(--s5) var(--s8);
    margin-bottom: var(--s12);
  }

  .crumb {
    display: flex;
    align-items: center;
    gap: var(--s2);
    font-family: var(--font-product);
    font-size: 13px;
    color: var(--faint);
    margin-bottom: var(--s5);
  }
  .crumb a { color: var(--muted); }
  .crumb a:hover { color: var(--brand-bright); }

  .post__cat { margin-bottom: var(--s3); font-family: var(--font-product); }

  .post__title {
    animation: titleIn var(--t-slow) var(--e-enter) both;
    animation-delay: 60ms;
    font-family: var(--font-blog);
    font-size: clamp(28px, 5.5vw, 32px);   /* HDS Blog Display */
    font-weight: 700;
    line-height: 1.44;
    letter-spacing: -1px;
    color: var(--ink);
    word-break: keep-all;
    margin-bottom: var(--s3);
  }
  .post__desc {
    font-family: var(--font-blog);
    font-size: 16px;
    color: var(--muted);
    word-break: keep-all;
    margin-bottom: var(--s4);
  }
  .post__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s2);
    font-family: var(--font-product);
  }

  .post__body { padding-bottom: var(--s12); }

  /* 이전/다음 — 블로그 표면이므로 20px 라디우스 */
  .post__nav {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--s3);
    padding-top: var(--s8);
    border-top: 1px solid var(--hairline);
  }
  .pn {
    display: flex;
    flex-direction: column;
    gap: var(--s1);
    padding: var(--s4) var(--s5);
    border-radius: var(--r-blog);
    background: var(--surface);
    box-shadow: var(--ring);
    min-width: 0;
    transition:
      background var(--t-fast) var(--e-std),
      box-shadow var(--t-fast) var(--e-std);
  }
  .pn:hover {
    background: var(--surface-2);
    box-shadow: inset 0 0 0 1px var(--brand-tint-line);
  }
  .pn--next { text-align: right; }
  .pn__t {
    font-family: var(--font-blog);
    font-size: 15px;
    font-weight: 700;
    color: var(--ink-soft);
    word-break: keep-all;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .post__back { margin-top: var(--s6); }
  .post__back .btn { font-family: var(--font-product); font-size: 14px; }
  /* 떠 있는 내비게이션이 마지막 줄을 가리지 않게 여유를 둔다 */
  .post { padding-bottom: 96px; }

  /* ── 떠 있는 이전/다음 ─────────────────────────────── */
  .dock {
    position: fixed;
    left: 50%;
    bottom: var(--s5);
    z-index: 50;
    display: flex;
    align-items: center;
    gap: var(--s1);
    max-width: calc(100vw - var(--s8));
    padding: 6px;
    border-radius: var(--r-pill);
    background: color-mix(in srgb, var(--surface) 88%, transparent);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    box-shadow: var(--ring), 0 8px 24px rgba(0, 0, 0, 0.12);
    font-family: var(--font-product);
    /* 숨김 상태: 아래로 살짝 내려가 있고 투명 */
    opacity: 0;
    transform: translate(-50%, 16px);
    pointer-events: none;
    transition:
      opacity var(--t-std) var(--e-std),
      transform var(--t-std) var(--e-enter);
  }
  .dock.is-on {
    opacity: 1;
    transform: translate(-50%, 0);
    pointer-events: auto;
  }

  .dock__btn {
    display: inline-flex;
    align-items: center;
    gap: var(--s2);
    min-width: 0;
    max-width: 240px;
    height: 40px;
    padding: 0 var(--s4);
    border-radius: var(--r-pill);
    font-size: 14px;
    font-weight: 600;
    color: var(--ink-soft);
    transition: background var(--t-fast) var(--e-std), color var(--t-fast) var(--e-std);
  }
  a.dock__btn:hover { background: var(--brand-tint); color: var(--brand-bright); }
  .dock__btn.is-off { color: var(--placeholder); }
  .dock__arrow { font-size: 20px; line-height: 1; margin-top: -2px; }
  .dock__t {
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  .dock__mid {
    flex-shrink: 0;
    height: 40px;
    padding: 0 var(--s4);
    display: inline-flex;
    align-items: center;
    border-left: 1px solid var(--hairline);
    border-right: 1px solid var(--hairline);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.4px;
    color: var(--muted);
    transition: color var(--t-fast) var(--e-std);
  }
  .dock__mid:hover { color: var(--brand-bright); }

  @media (max-width: 640px) {
    .post__nav { grid-template-columns: 1fr; }
    .pn--next { text-align: left; }
    .post__head { margin-bottom: var(--s8); }
    /* 좁은 화면에서는 제목을 빼고 화살표와 위치만 */
    .dock__t { display: none; }
    .dock__btn { padding: 0 var(--s4); }
  }

  @media (prefers-reduced-motion: reduce) {
    .dock { transition: opacity var(--t-std) linear; transform: translate(-50%, 0); }
  }

  @media print {
    .dock { display: none; }
  }
</style>
