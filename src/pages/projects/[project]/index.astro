---
import { render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ChapterRow from '../../../components/ChapterRow.astro';
import { getProjects, getChapters, groupChapters } from '../../../lib/content';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project) => ({
    params: { project: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { title, summary, stack, period, cover, gallery, repo, demo } = project.data;

// 상단 화면. gallery 가 있으면 돌리고, 없으면 cover 한 장만 세운다.
const shots = gallery.length > 0 ? gallery : cover ? [cover] : [];
const ROTATE_MS = 3500;

const chapters = await getChapters(project.id);
const { grouped, groups } = groupChapters(chapters);

// 프로젝트 .md 본문이 있으면 개요로 렌더
const { Content } = await render(project);
const hasIntro = (project.body ?? '').trim().length > 0;

// 그룹을 넘나들며 번호가 이어지도록 오프셋 계산
let counter = 0;
const numbered = groups.map((g) => {
  const items = g.items.map((c) => ({ chapter: c, n: ++counter }));
  return { name: g.name, items };
});
---

<BaseLayout title={title} description={summary}>
  <section class="top">
    <div class="wrap">
      <nav class="crumb" aria-label="경로">
        <a href="/">프로젝트</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">{title}</span>
      </nav>

      <div class="top__grid">
        <div class="top__text">
          <h1 class="top__title">{title}</h1>
          <p class="top__summary rise" style="--delay:60ms">{summary}</p>

          <div class="top__facts rise" style="--delay:100ms">
            {period && <span class="caption">{period}</span>}
            {period && <span class="caption" aria-hidden="true">·</span>}
            <span class="caption">챕터 {chapters.length}개</span>
          </div>

          {stack.length > 0 && (
            <ul class="top__stack rise" style="--delay:140ms">
              {stack.map((s) => <li class="chip">{s}</li>)}
            </ul>
          )}

          {(repo || demo) && (
            <div class="top__links rise" style="--delay:180ms">
              {repo && <a class="btn btn--ghost" href={repo} target="_blank" rel="noopener noreferrer">저장소</a>}
              {demo && <a class="btn btn--primary" href={demo} target="_blank" rel="noopener noreferrer">데모 보기</a>}
            </div>
          )}
        </div>

        {shots.length > 0 && (
          <div class="shot rise" style="--delay:80ms" data-shot data-interval={ROTATE_MS}>
            <div class="shot__frame">
              {shots.map((src, i) => (
                <img
                  class:list={['shot__img', i === 0 && 'is-on']}
                  src={src}
                  alt=""
                  width="800"
                  height="450"
                  decoding="async"
                  loading={i === 0 ? 'eager' : 'lazy'}
                />
              ))}
            </div>

            {shots.length > 1 && (
              <div class="shot__dots" role="tablist" aria-label="화면 미리보기">
                {shots.map((_, i) => (
                  <button
                    class:list={['shot__dot', i === 0 && 'is-on']}
                    type="button"
                    role="tab"
                    aria-selected={i === 0 ? 'true' : 'false'}
                    aria-label={`${i + 1}번째 화면`}
                  ></button>
                ))}
              </div>
            )}
          </div>
        )}
      </div>
    </div>
  </section>

  {hasIntro && (
    <section class="wrap intro">
      <div class="intro__card">
        <div class="prose"><Content /></div>
      </div>
    </section>
  )}

  <section class="wrap chapters">
    <div class="chapters__head">
      <h2 class="section-title">챕터</h2>
      <span class="caption">클릭하면 글이 열립니다</span>
    </div>

    {chapters.length === 0 ? (
      <div class="empty">
        <p class="empty__line">아직 작성된 챕터가 없습니다.</p>
        <p class="caption">
          <code>src/content/chapters/{project.id}/</code> 에 <code>.md</code> 파일을 추가해 보세요.
        </p>
      </div>
    ) : (
      <div class="chapters__list">
        {numbered.map((g) => (
          <>
            {grouped && <h3 class="group">{g.name}</h3>}
            {g.items.map(({ chapter, n }, i) => (
              <ChapterRow chapter={chapter} n={n} index={i} />
            ))}
          </>
        ))}
      </div>
    )}
  </section>
</BaseLayout>

<style>
  .top {
    background: var(--brand-tint);
    border-bottom: 1px solid var(--hairline);
    padding-block: var(--s5) var(--s12);
    margin-bottom: var(--s12);
  }

  .crumb {
    display: flex;
    align-items: center;
    gap: var(--s2);
    font-size: 13px;
    color: var(--faint);
    margin-bottom: var(--s6);
  }
  .crumb a { color: var(--muted); }
  .crumb a:hover { color: var(--brand-bright); }
  .crumb [aria-current] { color: var(--ink-soft); }

  .top__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--s8);
    align-items: center;
  }
  @media (min-width: 900px) {
    .top__grid:has(.shot) { grid-template-columns: 1fr 0.9fr; }
  }

  .top__text { display: flex; flex-direction: column; gap: var(--s4); align-items: flex-start; }
  .top__title {
    animation: titleIn var(--t-slow) var(--e-enter) both;
    animation-delay: 60ms;
    font-size: clamp(28px, 5vw, 40px);
    font-weight: 700;
    line-height: 1.25;
    letter-spacing: -0.8px;
    color: var(--ink);
  }
  .top__summary {
    font-size: 16px;
    color: var(--muted);
    max-width: 56ch;
    word-break: keep-all;
  }
  .top__facts { display: flex; align-items: center; gap: var(--s2); }
  .top__stack { display: flex; flex-wrap: wrap; gap: var(--s1); list-style: none; margin: 0; padding: 0; }
  .top__links { display: flex; flex-wrap: wrap; gap: var(--s2); margin-top: var(--s1); }

  /* ── 상단 화면 로테이션 ────────────────────────────────
     같은 자리에서 겹친 이미지의 불투명도만 바꾼다. 레이아웃은
     건드리지 않으므로 전환 중에도 높이가 흔들리지 않는다.   */
  .shot { display: flex; flex-direction: column; gap: var(--s3); }
  .shot__frame {
    position: relative;
    aspect-ratio: 16 / 9;
    border-radius: var(--r-card);
    overflow: hidden;
    background: var(--surface);
    box-shadow: var(--ring), var(--shadow-card);
  }
  .shot__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    opacity: 0;
    transition: opacity var(--t-slow) var(--e-std);
  }
  .shot__img.is-on { opacity: 1; }

  .shot__dots { display: flex; justify-content: center; gap: var(--s2); }
  .shot__dot {
    width: 7px;
    height: 7px;
    padding: 0;
    border: 0;
    border-radius: var(--r-pill);
    background: var(--divider);
    cursor: pointer;
    transition:
      width var(--t-std) var(--e-std),
      background var(--t-std) var(--e-std);
  }
  .shot__dot:hover { background: var(--muted); }
  .shot__dot.is-on { width: 18px; background: var(--brand); }

  .intro { margin-bottom: var(--s12); }
  .intro__card {
    padding: var(--s8);
    border-radius: var(--r-card);
    background: var(--surface);
    box-shadow: var(--ring);
  }
  @media (max-width: 640px) { .intro__card { padding: var(--s5); } }

  .chapters__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--s3);
    margin-bottom: var(--s5);
  }
  .chapters__list { display: flex; flex-direction: column; gap: var(--s3); }

  /* 카테고리 그룹 헤더 — category 를 쓴 프로젝트에서만 나타난다 */
  .group {
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--faint);
    text-transform: uppercase;
    margin-top: var(--s6);
    padding-bottom: var(--s2);
    border-bottom: 1px solid var(--hairline);
  }
  .group:first-child { margin-top: 0; }

  .empty {
    padding: var(--s12) var(--s5);
    border-radius: var(--r-card);
    box-shadow: var(--ring);
    text-align: center;
  }
  .empty__line { color: var(--ink); margin-bottom: var(--s2); }
  .empty code {
    font-family: var(--font-mono);
    font-size: 12px;
    padding: 0.15em 0.4em;
    border-radius: var(--r-chip);
    background: var(--surface-2);
    color: var(--brand-bright);
  }
</style>

<script>
  // 상단 화면 로테이션. 호버하면 멈추고, 탭이 가려져 있으면 돌지 않는다.
  document.querySelectorAll<HTMLElement>('[data-shot]').forEach((root) => {
    const imgs = Array.from(root.querySelectorAll<HTMLElement>('.shot__img'));
    const dots = Array.from(root.querySelectorAll<HTMLElement>('.shot__dot'));
    if (imgs.length < 2) return;

    const wait = Number(root.dataset.interval) || 3500;
    const calm = window.matchMedia('(prefers-reduced-motion: reduce)');
    let at = 0;
    let timer: number | undefined;

    const show = (n: number) => {
      at = (n + imgs.length) % imgs.length;
      imgs.forEach((el, k) => el.classList.toggle('is-on', k === at));
      dots.forEach((el, k) => {
        el.classList.toggle('is-on', k === at);
        el.setAttribute('aria-selected', String(k === at));
      });
    };

    const stop = () => {
      if (timer !== undefined) window.clearInterval(timer);
      timer = undefined;
    };
    const start = () => {
      stop();
      if (calm.matches) return;          // 모션을 줄인 사용자에게는 자동 전환 없음
      timer = window.setInterval(() => show(at + 1), wait);
    };

    dots.forEach((d, k) =>
      d.addEventListener('click', () => {
        show(k);
        start();
      }),
    );

    root.addEventListener('mouseenter', stop);
    root.addEventListener('mouseleave', start);
    document.addEventListener('visibilitychange', () => (document.hidden ? stop() : start()));

    start();
  });
</script>
