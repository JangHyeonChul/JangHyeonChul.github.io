---
import { site } from '../site.config';
import ThemeToggle from './ThemeToggle.astro';

const path = Astro.url.pathname;
const onHome = path === '/';
---

<header class="hd">
  <div class="wrap hd__in">
    <a class="hd__brand" href="/" aria-current={onHome ? 'page' : undefined}>
      <span class="hd__mark" aria-hidden="true"></span>
      <span class="hd__name">{site.name}</span>
    </a>

    {/* 링크는 히어로의 연락 카드가 담당한다. 여기는 테마 토글만. */}
    <ThemeToggle />
  </div>
</header>

<style>
  /* HDS Navigation: 헤어라인으로만 분리하고, 내용은 최소로 */
  .hd {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--header-bg);
    backdrop-filter: saturate(140%) blur(10px);
    border-bottom: 1px solid var(--hairline);
  }
  .hd__in {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s4);
    height: 60px;
  }
  .hd__brand {
    display: inline-flex;
    align-items: center;
    gap: var(--s2);
    font-size: 15px;
    font-weight: 600;
    color: var(--ink-soft);
  }
  /* 브랜드 마크 — 터콰이즈는 아이덴티티에만, 장식으로 퍼뜨리지 않는다 */
  .hd__mark {
    width: 10px;
    height: 10px;
    border-radius: var(--r-pill);
    background: var(--brand);
  }
</style>
