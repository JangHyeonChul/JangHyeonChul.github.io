---
import type { Project } from '../lib/content';

interface Props {
  project: Project;
  chapterCount: number;
  index?: number;
}

const { project, chapterCount, index = 0 } = Astro.props;
const { title, summary, detail, stack, period, cover } = project.data;
const href = `/projects/${project.id}/`;
const SHOWN = 4;                        // 기본 상태에서 보이는 스택 칩 수
const hidden = Math.max(0, stack.length - SHOWN);
// 빈 줄 기준으로 문단을 나눈다. detail 이 없으면 호버해도 요약만 남는다.
const detailParas = (detail ?? '').split(/\n\s*\n/).map((t) => t.trim()).filter(Boolean);
---

<article class="card rise" style={`--delay:${index * 45}ms`}>
  <a class="card__hit" href={href} aria-labelledby={`p-${project.id}`}>
    <div class="card__cover">
      {cover
        ? <img src={cover} alt="" loading="lazy" decoding="async" width="600" height="338" />
        : <span class="card__ph" aria-hidden="true">{title.slice(0, 1)}</span>}
    </div>

    <div class="card__body">
      <h3 class="section-title card__title" id={`p-${project.id}`}>{title}</h3>

      {/* 요약은 늘 그대로 있고, 호버하면 그 아래로 자세한 설명이 붙는다 */}
      <p class="card__summary">{summary}</p>

      {detailParas.length > 0 && (
        <div class="card__detail">
          {detailParas.map((t) => <p>{t}</p>)}
        </div>
      )}

      {stack.length > 0 && (
        <ul class="card__stack">
          {stack.map((s, i) => (
            <li class={i < SHOWN ? 'chip' : 'chip chip--extra'}>{s}</li>
          ))}
          {hidden > 0 && <li class="chip chip--more">+{hidden}</li>}
        </ul>
      )}

      <div class="card__meta caption">
        <span class="card__count">챕터 {chapterCount}</span>
        {period && <><span aria-hidden="true">·</span><span>{period}</span></>}
      </div>
    </div>
  </a>
</article>

<style>
  /* HDS Product Card: 16px 라디우스 + 헤어라인 링.
     다크에서는 그림자가 거의 안 읽혀 링에 더 의존한다.

     높이를 고정한 이유 — 호버하면 커버가 줄고 본문이 그만큼
     자란다. 카드 바깥 치수가 바뀌지 않아야 그리드가 흔들리지
     않으므로, 총 높이를 상수로 두고 내부에서만 주고받는다.

     440/240 인 이유 — 호버하면 요약 아래로 detail 이 통째로 붙는다.
     가장 좁은 칸(320px)에서 본문이 6줄 + 칩 2줄까지 가므로 그만큼
     자리를 미리 확보해 둔 것이다. 쉬는 상태의 본문 높이는 200px 로
     예전과 같고, 늘어난 40px 는 커버가 가져갔다.  */
  .card {
    position: relative;
    height: 440px;
    border-radius: var(--r-card);
    background: var(--surface);
    box-shadow: var(--ring);
    overflow: hidden;
    transition:
      transform var(--t-std) var(--e-enter),
      background var(--t-std) var(--e-std),
      box-shadow var(--t-std) var(--e-std);
  }
  .card:hover {
    transform: translateY(-3px);        /* HDS: 살짝 떠오름, 바운스 없음 */
    background: var(--surface-2);
    box-shadow: inset 0 0 0 1px var(--brand-tint-line), var(--shadow-card);
  }
  .card:has(.card__hit:focus-visible) { transform: translateY(-3px); }

  .card__hit { display: flex; flex-direction: column; height: 100%; }

  /* 이미지가 색을 담당하고 크롬은 조용히 — HDS 원칙 3.
     커버 위에 아무것도 덮지 않으므로 사진은 계속 보인다.    */
  .card__cover {
    position: relative;
    flex: none;
    height: 240px;
    background: var(--brand-tint);
    border-bottom: 1px solid var(--hairline);
    display: grid;
    place-items: center;
    overflow: hidden;
    transition: height var(--t-std) var(--e-std);
  }
  .card__cover img {
    width: 100%; height: 100%;
    object-fit: cover;
    object-position: top center;        /* 스크린샷은 위쪽이 본체다 */
  }

  .card__ph {
    font-size: 44px;
    font-weight: 700;
    color: var(--brand-bright);
    opacity: 0.55;
    user-select: none;
  }

  .card__body {
    display: flex;
    flex-direction: column;
    gap: var(--s3);
    padding: var(--s5);
    flex: 1;
    min-height: 0;
    overflow: hidden;                   /* 자라는 동안 글이 쓸리며 드러난다 */
  }
  .card__title { margin: 0; }

  .card__summary {
    margin: 0;
    font-size: 14px;
    line-height: 1.6;
    color: var(--muted);
    word-break: keep-all;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* 기본 상태에서는 자리를 아예 차지하지 않는다.
     호버하면 커버가 내준 만큼만 쓰고, 넘치면 조용히 잘린다.
     위쪽 헤어라인이 요약(제목 역할)과 본문을 갈라 준다.     */
  .card__detail {
    display: none;
    margin: 0;
    padding-top: var(--s3);
    border-top: 1px solid var(--hairline);
    min-height: 0;
    overflow: hidden;
  }
  .card__detail p {
    margin: 0 0 var(--s2);
    font-size: 13px;
    line-height: 1.65;
    color: var(--body);
    word-break: keep-all;
  }
  .card__detail p:last-child { margin-bottom: 0; }

  .card__stack {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s1);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  /* 기본 상태에서는 4개까지만. 나머지는 +N 으로 개수만 알린다 */
  .chip--extra { display: none; }
  .chip--more { color: var(--brand-bright); font-weight: 600; }

  /* 포인터가 있는 환경에서만. 터치에서는 탭이 호버로 끈적하게 남는다 */
  @media (hover: hover) {
    .card:hover .card__cover,
    .card:has(.card__hit:focus-visible) .card__cover { height: 64px; }

    .card:hover .card__detail,
    .card:has(.card__hit:focus-visible) .card__detail { display: block; }

    /* 본문이 붙는 순간 요약은 그 묶음의 제목처럼 읽혀야 한다 */
    .card:hover .card__summary,
    .card:has(.card__hit:focus-visible) .card__summary {
      -webkit-line-clamp: 3;
      color: var(--ink-soft);
      font-weight: 600;
    }

    .card:hover .chip--extra,
    .card:has(.card__hit:focus-visible) .chip--extra { display: inline-flex; }

    .card:hover .chip--more,
    .card:has(.card__hit:focus-visible) .chip--more { display: none; }
  }

  .card__meta {
    display: flex;
    align-items: center;
    gap: var(--s2);
    margin-top: auto;
    padding-top: var(--s2);
  }
  .card__count { color: var(--brand-bright); font-weight: 600; }

  @media (max-width: 640px) {
    .card { height: 380px; }
    .card__cover { height: 190px; }
  }
</style>
