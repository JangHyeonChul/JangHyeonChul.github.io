---
import type { Project } from '../lib/content';

interface Props {
  project: Project;
  chapterCount: number;
  index?: number;
}

const { project, chapterCount, index = 0 } = Astro.props;
const { title, summary, detail, stack, period, cover } = project.data;
const href = `/projects/${project.id}/`;
const SHOWN = 4;                        // 기본 상태에서 보이는 스택 칩 수
const hidden = Math.max(0, stack.length - SHOWN);
const more = detail ?? summary;         // detail 이 없으면 summary 를 그대로
---

<article class="card rise" style={`--delay:${index * 45}ms`}>
  <a class="card__hit" href={href} aria-labelledby={`p-${project.id}`}>
    <div class="card__cover">
      {cover
        ? <img src={cover} alt="" loading="lazy" decoding="async" width="600" height="338" />
        : <span class="card__ph" aria-hidden="true">{title.slice(0, 1)}</span>}
    </div>

    <div class="card__body">
      <h3 class="section-title card__title" id={`p-${project.id}`}>{title}</h3>

      {/* 기본은 요약 두 줄, 호버하면 본문이 위로 자라며 자세한 설명으로 바뀐다 */}
      <p class="card__summary">{summary}</p>
      <p class="card__detail">{more}</p>

      {stack.length > 0 && (
        <ul class="card__stack">
          {stack.map((s, i) => (
            <li class={i < SHOWN ? 'chip' : 'chip chip--extra'}>{s}</li>
          ))}
          {hidden > 0 && <li class="chip chip--more">+{hidden}</li>}
        </ul>
      )}

      <div class="card__meta caption">
        <span class="card__count">챕터 {chapterCount}</span>
        {period && <><span aria-hidden="true">·</span><span>{period}</span></>}
      </div>
    </div>
  </a>
</article>

<style>
  /* HDS Product Card: 16px 라디우스 + 헤어라인 링.
     다크에서는 그림자가 거의 안 읽혀 링에 더 의존한다.

     높이를 고정한 이유 — 호버하면 커버가 줄고 본문이 그만큼
     자란다. 카드 바깥 치수가 바뀌지 않아야 그리드가 흔들리지
     않으므로, 총 높이를 상수로 두고 내부에서만 주고받는다.  */
  .card {
    position: relative;
    height: 400px;
    border-radius: var(--r-card);
    background: var(--surface);
    box-shadow: var(--ring);
    overflow: hidden;
    transition:
      transform var(--t-std) var(--e-enter),
      background var(--t-std) var(--e-std),
      box-shadow var(--t-std) var(--e-std);
  }
  .card:hover {
    transform: translateY(-3px);        /* HDS: 살짝 떠오름, 바운스 없음 */
    background: var(--surface-2);
    box-shadow: inset 0 0 0 1px var(--brand-tint-line), var(--shadow-card);
  }
  .card:has(.card__hit:focus-visible) { transform: translateY(-3px); }

  .card__hit { display: flex; flex-direction: column; height: 100%; }

  /* 이미지가 색을 담당하고 크롬은 조용히 — HDS 원칙 3.
     커버 위에 아무것도 덮지 않으므로 사진은 계속 보인다.    */
  .card__cover {
    position: relative;
    flex: none;
    height: 200px;
    background: var(--brand-tint);
    border-bottom: 1px solid var(--hairline);
    display: grid;
    place-items: center;
    overflow: hidden;
    transition: height var(--t-std) var(--e-std);
  }
  .card__cover img {
    width: 100%; height: 100%;
    object-fit: cover;
    object-position: top center;        /* 스크린샷은 위쪽이 본체다 */
  }

  .card__ph {
    font-size: 44px;
    font-weight: 700;
    color: var(--brand-bright);
    opacity: 0.55;
    user-select: none;
  }

  .card__body {
    display: flex;
    flex-direction: column;
    gap: var(--s3);
    padding: var(--s5);
    flex: 1;
    min-height: 0;
    overflow: hidden;                   /* 자라는 동안 글이 쓸리며 드러난다 */
  }
  .card__title { margin: 0; }

  .card__summary,
  .card__detail {
    margin: 0;
    font-size: 14px;
    line-height: 1.6;
    color: var(--muted);
    word-break: keep-all;
  }
  .card__summary {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .card__detail { display: none; }

  .card__stack {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s1);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  /* 기본 상태에서는 4개까지만. 나머지는 +N 으로 개수만 알린다 */
  .chip--extra { display: none; }
  .chip--more { color: var(--brand-bright); font-weight: 600; }

  /* 포인터가 있는 환경에서만. 터치에서는 탭이 호버로 끈적하게 남는다 */
  @media (hover: hover) {
    .card:hover .card__cover,
    .card:has(.card__hit:focus-visible) .card__cover { height: 96px; }

    .card:hover .card__summary,
    .card:has(.card__hit:focus-visible) .card__summary { display: none; }

    .card:hover .card__detail,
    .card:has(.card__hit:focus-visible) .card__detail {
      display: -webkit-box;
      -webkit-line-clamp: 5;
      -webkit-box-orient: vertical;
      overflow: hidden;
      color: var(--body);
    }

    .card:hover .chip--extra,
    .card:has(.card__hit:focus-visible) .chip--extra { display: inline-flex; }

    .card:hover .chip--more,
    .card:has(.card__hit:focus-visible) .chip--more { display: none; }
  }

  .card__meta {
    display: flex;
    align-items: center;
    gap: var(--s2);
    margin-top: auto;
    padding-top: var(--s2);
  }
  .card__count { color: var(--brand-bright); font-weight: 600; }

  @media (max-width: 640px) {
    .card { height: 380px; }
    .card__cover { height: 190px; }
  }
</style>
